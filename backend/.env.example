# === Core ===
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ads_saas

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_your_own_generated_secret

# Generate your own with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change this after you have connected accounts — you will lose the
# ability to decrypt stored refresh tokens and every client will need to reconnect.
FERNET_KEY=replace_with_your_own_generated_fernet_key

# === Google OAuth (Google Cloud Console credentials) ===
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# === Google Ads API ===
# Developer token from your MCC: Google Ads UI -> Admin -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
# Your MCC's customer id, digits only, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vipulgupta1994@gmail.com
SMTP_PASSWORD=mknmayxzeegzhukv
FROM_NAME=Ads Optimizer

# === Safety defaults for newly-connected accounts ===
DEFAULT_DRY_RUN=true
DEFAULT_MAX_ACTIONS_PER_RUN=25

# === Frontend ===
FRONTEND_URL=http://localhost:5173
JWT_EXPIRE_MINUTES=10080
